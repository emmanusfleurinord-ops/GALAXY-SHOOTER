<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Galaxy Shooter</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; }
  body { background:#02010a; height:100vh; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:"Segoe UI", system-ui, sans-serif; color:#c8f7ff; }
  body.advanced { background: radial-gradient(ellipse at 50% 20%, #042048 0%, #02010a 55%); }
  h1 { font-size:clamp(14px,3vh,22px); letter-spacing:6px; text-shadow:0 0 10px #0ff,0 0 24px #08f; margin:4px 0; }
  #wrap { position:relative; border:3px solid #0cf; box-shadow:0 0 28px #0ff5; max-height:calc(100vh - 88px); }
  body.full #wrap { border:0; box-shadow:none; max-height:100vh; }
  canvas { display:block; background:#000010; width:min(480px,92vw); height:auto; max-height:calc(100vh - 88px); }
  body.full canvas { width:min(100vw, calc(100vh * 480 / 640)); max-height:100vh; }
  body.advanced canvas { filter: contrast(1.12) saturate(1.2) brightness(1.05); }
  #scan { display:none; pointer-events:none; position:absolute; inset:0; background: repeating-linear-gradient(to bottom, rgba(0,255,255,.03) 0 1px, transparent 2px 4px); }
  body.advanced #scan { display:block; }
  #hud { position:absolute; top:8px; left:10px; right:10px; z-index:2; pointer-events:none; display:flex; justify-content:space-between; gap:8px; font-size:13px; text-shadow:0 0 8px #0ff; }
  #hearts { font-size:18px; letter-spacing:2px; filter: drop-shadow(0 0 6px #f46); }
  .timer { display:none; margin-top:3px; background:#021018cc; border:1px solid #2ac8; border-radius:6px; padding:3px 6px; }
  .timer.on { display:block; }
  .bar { height:4px; background:#133; border-radius:2px; margin-top:3px; overflow:hidden; }
  .bar > i { display:block; height:100%; width:0; background:#0ff; }
  #warn, #toast { position:absolute; left:0; right:0; text-align:center; pointer-events:none; z-index:3; font-weight:800; letter-spacing:2px; display:none; }
  #warn { top:38%; font-size:20px; color:#ff6; text-shadow:0 0 12px #f80; }
  #toast { top:20%; font-size:16px; color:#9ff; text-shadow:0 0 10px #0ff; }
  #hint { margin:6px 0 2px; font-size:12px; color:#7bd; }
  body.full #hint, body.full h1 { display:none; }
  .overlay { position:absolute; inset:0; background:rgba(0,4,16,.82); display:none; align-items:center; justify-content:center; z-index:5; backdrop-filter:blur(3px); }
  .overlay.show { display:flex; }
  .panel { width:min(370px,90%); max-height:92%; overflow:auto; border:1px solid #2cf; background:linear-gradient(180deg,#041428ee,#020814f2); padding:16px; border-radius:10px; box-shadow:0 0 24px #0ff4; }
  .panel h2 { text-align:center; letter-spacing:3px; font-size:18px; color:#7ff; text-shadow:0 0 10px #0ff; margin-bottom:10px; }
  .panel p { text-align:center; color:#bdf; font-size:14px; margin:6px 0; }
  .btn { display:block; width:100%; margin:7px 0; padding:10px; background:#032036; color:#cffffa; border:1px solid #1ad; border-radius:8px; cursor:pointer; font-size:15px; }
  .btn:hover { background:#064060; }
  .btn.main { background:#05334a; border-color:#3ff; }
  .row { display:flex; justify-content:space-between; align-items:center; margin:8px 0; font-size:13px; gap:10px; }
  select, input[type=range] { accent-color:#0cf; }
  select { background:#021018; color:#dff; border:1px solid #1ad; padding:4px 6px; border-radius:6px; }
  .keys { font-size:12px; color:#9de; line-height:1.45; background:#011018; border:1px solid #145; padding:8px; border-radius:6px; }
  #levelGrid { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; max-height:230px; overflow:auto; margin:8px 0; padding:4px; }
  #levelGrid button { padding:6px 0; font-size:11px; background:#021526; color:#cff; border:1px solid #146; border-radius:5px; cursor:pointer; }
  #levelGrid button.on { background:#0a4; border-color:#6f8; color:#fff; }
  #levelGrid button.lock { opacity:.35; cursor:not-allowed; }
</style>
</head>
<body>
<h1>✦ GALAXY SHOOTER ✦</h1>
<div id="wrap">
  <canvas id="c" width="480" height="640"></canvas>
  <div id="scan"></div>
  <div id="hud">
    <div>
      <div id="hearts">❤️❤️❤️</div>
      <div id="hpEl">TIROS: 0 / 5</div>
      <div id="scoreEl">PONTOS: 0</div>
      <div id="waveEl">NÍVEL 1 / 300</div>
      <div id="subEl">TEMPO 2:00</div>
    </div>
    <div>
      <div class="timer" id="tDouble"><b>TIRO DUPLO</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tTriple"><b>TIRO TRIPLO</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tShield"><b>ESCUDO</b> <span>0s</span><div class="bar"><i></i></div></div>
    </div>
  </div>
  <div id="warn">⚠ CHEFÃO CHEGANDO ⚠</div>
  <div id="toast"></div>

  <div class="overlay show" id="ovStart">
    <div class="panel">
      <h2>GALAXY SHOOTER</h2>
      <button class="btn main" id="btnLevels">▶  ESCOLHER NÍVEL</button>
      <button class="btn" id="btnCfgStart">⚙  CONFIGURAÇÕES</button>
      <div class="keys" id="saveInfo">Teclado ou controle (manette). 300 chefões diferentes.</div>
    </div>
  </div>
  <div class="overlay" id="ovLevels">
    <div class="panel">
      <h2>ESCOLHER NÍVEL</h2>
      <p id="unlockInfo">Liberados até o nível 1</p>
      <div id="levelGrid"></div>
      <button class="btn main" id="btnPlayPick">▶  JOGAR NÍVEL 1</button>
      <button class="btn" id="btnLvBack">↩  VOLTAR</button>
    </div>
  </div>
  <div class="overlay" id="ovPause">
    <div class="panel">
      <h2>PAUSA</h2>
      <button class="btn main" id="btnResume">▶  CONTINUAR</button>
      <button class="btn" id="btnCfgPause">⚙  CONFIGURAÇÕES</button>
      <button class="btn" id="btnMenu">↩  TELA INICIAL</button>
    </div>
  </div>
  <div class="overlay" id="ovClear">
    <div class="panel">
      <h2>NÍVEL COMPLETO</h2>
      <p id="clearLevel">Nível 1 de 300</p>
      <p id="clearBoss">Chefão derrotado</p>
      <p id="clearScore">Pontos: 0</p>
      <button class="btn main" id="btnPickAfter">▶  ESCOLHER PRÓXIMO NÍVEL</button>
      <button class="btn" id="btnClearMenu">↩  TELA INICIAL</button>
    </div>
  </div>
  <div class="overlay" id="ovCfg">
    <div class="panel">
      <h2>CONFIGURAÇÕES</h2>
      <div class="row"><label>Som</label>
        <select id="optSound"><option value="on">Ligado</option><option value="off">Desligado</option></select></div>
      <div class="row"><label>Volume</label><input id="optVol" type="range" min="0" max="100" value="70"></div>
      <div class="row"><label>Pacote de som</label>
        <select id="optPack">
          <option value="0">1. Clássico</option>
          <option value="1">2. Laser Neon</option>
          <option value="2">3. Estrela</option>
          <option value="3">4. Robô</option>
          <option value="4">5. Cristal</option>
          <option value="5">6. Trovão</option>
          <option value="6">7. 8-bits</option>
          <option value="7">8. Espacial</option>
          <option value="8">9. Doce</option>
          <option value="9">10. Heroico</option>
        </select></div>
      <button class="btn" id="btnPreview" type="button">♪  Ouvir o som escolhido</button>
      <div class="row"><label>Tela</label>
        <select id="optScreen">
          <option value="normal">Normal</option>
          <option value="full">Cheia</option>
          <option value="advanced">Cheia avançada</option>
        </select></div>
      <div class="row"><label>Dificuldade</label>
        <select id="optDiff">
          <option value="easy">Fácil</option>
          <option value="normal">Normal</option>
          <option value="hard">Difícil</option>
        </select></div>
      <div class="row"><label>Velocidade dos inimigos</label>
        <select id="optESpd">
          <option value="very">Bem lenta</option>
          <option value="slow">Lenta</option>
          <option value="normal">Normal</option>
          <option value="fast">Rápida</option>
        </select></div>
      <div class="row"><label>Fundo da tela</label>
        <select id="optBg">
          <option value="atual">Atual (brilhante)</option>
          <option value="noite">Noite escura</option>
          <option value="azul">Azul suave</option>
          <option value="roxo">Roxo profundo</option>
          <option value="verde">Verde calmo</option>
          <option value="ouro">Dourado fraco</option>
          <option value="estrelas">Só estrelas</option>
          <option value="aurora">Aurora</option>
          <option value="vermelho">Vermelho suave</option>
          <option value="oceano">Oceano</option>
          <option value="cinza">Cinza espacial</option>
        </select></div>
      <div class="row"><label>Velocidade da nave</label>
        <select id="optSpeed">
          <option value="slow">Lenta</option>
          <option value="normal">Normal</option>
          <option value="fast">Rápida</option>
        </select></div>
      <div class="row"><label>Controle / manette</label>
        <select id="optPad"><option value="on">Ligado</option><option value="off">Desligado</option></select></div>
      <div class="row"><label>Tiro automático</label>
        <select id="optAuto"><option value="off">Não</option><option value="on">Sim</option></select></div>
      <div class="row"><label>Amigos de suporte</label>
        <select id="optAlly"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="row"><label>Efeitos visuais</label>
        <select id="optFx">
          <option value="low">Mínimo</option>
          <option value="normal">Normal</option>
          <option value="high">Máximo</option>
        </select></div>
      <div class="row"><label>Tremor de tela</label>
        <select id="optShake"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="row"><label>Mostrar cronômetro</label>
        <select id="optClock"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="keys">W A S D ou setas • ESPAÇO atira • ESC pausa<br>Corações caem no jogo para recuperar vida</div>
      <button class="btn main" id="btnCfgBack">↩  VOLTAR</button>
    </div>
  </div>
</div>
<p id="hint">Escolha o nível • Teclado ou controle (manette) • ESPAÇO / botão A atira • ESC / Start pausa</p>
<script>
const canvas=document.getElementById("c"), ctx=canvas.getContext("2d");
const W=canvas.width, H=canvas.height, IMG={};
const SRC = {
  player: "data:image/png;base64,",
  enemy: "data:image/png;base64,",
  elite: "data:image/png;base64,",
  boss: "data:image/png;base64,",
  pwr_double: "data:image/png;base64,",
  pwr_shield: "data:image/png;base64,",
  boom: "data:image/png;base64,",
  boomBoss: "data:image/png;base64,",
  bg: "data:image/jpeg;base64,"

};
const MAX_LEVEL=300;
const DOUBLE_MAX=60*12, TRIPLE_MAX=60*10, SHIELD_MAX=60*14;
const N1=["Vórtex","Nébula","Kraag","Zorath","Nyx","Helion","Drak","Quasar","Orion","Vex","Sable","Pyra","Ion","Ruk","Astra","Morb","Kel","Zeph","Onyx","Luma"];
const N2=["Carmesim","Gélido","Solar","Umbra","Titã","Feral","Ómega","Prismático","Oco","Radiante","Bruto","Etéreo","Colosso","Sombrio","Vivo","Quebrado","Ancestral","Novo","Final","Errante"];
const N3=["da Chama","do Vazio","de Ferro","de Cristal","da Tempestade","do Eclipse","da Maré","do Ápice","de Plasma","da Ruína","das Asas","do Núcleo","da Orbe","dos Canhões","da Serpe","do Cometa","da Torre","do Abismo","da Aurora","do Pacto"];
const MOVE_NAME=["Varredura","Perseguição","Mergulho","Caçada","Órbita","Ricochete","Investida","Régua","Triângulo","Assalto","Pêndulo","Salto"];
const ATK_NAME=["Feixe","Leque","Mira","Combo","Explosão","Canhões","Rajada","Zigzag","Cruz","Anel"];
function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
function rects(a,b){ return a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y; }
function makeBoss(n){
  const hue=(n*47+13)%360, move=(n*3+1)%12, atk=(n*5+2)%10, body=(n*5)%12;
  return { name:N1[(n-1)%20]+" "+N2[(n*3)%20]+" "+N3[(n*11)%20], hue, move, atk, body,
    moveName:MOVE_NAME[move], atkName:ATK_NAME[atk], w:110+(n%9)*6, h:100+(n%7)*6 };
}
function levelMinutes(n){ return Math.min(6, 1+n); } // 1=2min, 2=3min ... cap 6
function getLevel(n){
  n=clamp(n|0,1,MAX_LEVEL);
  const mins=levelMinutes(n);
  return {
    n, boss:makeBoss(n), minutes:mins,
    preBoss: mins*60*60,
    spawnInterval: Math.max(16, 72 - n*0.12),
    enemySpeed: 1.05 + n*0.012,
    eliteChance: clamp(0.08 + n*0.0015, 0.08, 0.55),
    enemyHp: 1 + Math.floor((n-1)/16),
    eliteHp: 2 + Math.floor((n-1)/11),
    playerDmg: 1 + Math.floor((n-1)/28),
    bossHp: Math.floor(60 + n*5.0 + (n*n)/200),
    bossSpeed: 1.05 + n*0.017,
    bossChase: 0.55 + n*0.012,
    bossFire: Math.max(12, 60 - n*0.12),
    allies: (n%10===0)?2:(n%5===0?1:0),
    dropChance: clamp(0.24 + n*0.0004, 0.24, 0.42)
  };
}

const cfg={sound:true,volume:0.7,pack:0,screen:"normal",from:"start",diff:"normal",speed:"normal",eSpd:"slow",bg:"atual",pad:true,auto:false,ally:true,fx:"normal",shake:true,clock:true};
const save={unlocked:1,score:0,pick:1};
try{ Object.assign(cfg, JSON.parse(localStorage.getItem("gs-cfg")||"{}")); }catch(e){}
try{ Object.assign(save, JSON.parse(localStorage.getItem("gs-save")||"{}")); }catch(e){}
if(!save.unlocked) save.unlocked=1;
function persist(){
  try{
    localStorage.setItem("gs-cfg", JSON.stringify(cfg));
    localStorage.setItem("gs-save", JSON.stringify(save));
  }catch(e){}
}
function applyScreen(){
  document.body.classList.toggle("full", cfg.screen!=="normal");
  document.body.classList.toggle("advanced", cfg.screen==="advanced");
  const r=document.documentElement;
  if(cfg.screen!=="normal"){ if(!document.fullscreenElement && r.requestFullscreen) r.requestFullscreen().catch(()=>{}); }
  else if(document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(()=>{});
}
function shipSpeed(){ return cfg.speed==="slow"?4.2: cfg.speed==="fast"?7.2:5.6; }
function enemySpdMul(){ return cfg.eSpd==="very"?0.32: cfg.eSpd==="slow"?0.55: cfg.eSpd==="fast"?1.35:1; }
function diffMul(){ return cfg.diff==="easy"?0.7: cfg.diff==="hard"?1.35:1; }

const ovStart=document.getElementById("ovStart"), ovPause=document.getElementById("ovPause");
const ovCfg=document.getElementById("ovCfg"), ovClear=document.getElementById("ovClear"), ovLevels=document.getElementById("ovLevels");
function showOnly(el){ [ovStart,ovPause,ovCfg,ovClear,ovLevels].forEach(x=>x.classList.remove("show")); if(el) el.classList.add("show"); }

let pickLevel=save.pick||1;
function buildLevelGrid(){
  const g=document.getElementById("levelGrid"); g.innerHTML="";
  for(let i=1;i<=MAX_LEVEL;i++){
    const b=document.createElement("button");
    b.textContent=i;
    if(i>save.unlocked){ b.className="lock"; b.disabled=true; }
    if(i===pickLevel) b.classList.add("on");
    b.onclick=()=>{ if(i>save.unlocked) return; pickLevel=i; save.pick=i; persist(); buildLevelGrid(); document.getElementById("btnPlayPick").textContent="▶  JOGAR NÍVEL "+i; };
    g.appendChild(b);
  }
  document.getElementById("unlockInfo").textContent="Liberados até o nível "+save.unlocked+" • Nível "+pickLevel+" selecionado";
  document.getElementById("btnPlayPick").textContent="▶  JOGAR NÍVEL "+pickLevel;
}
function openLevels(){ pickLevel=Math.min(save.pick||1, save.unlocked); buildLevelGrid(); showOnly(ovLevels); }
function refreshSaveInfo(){
  document.getElementById("saveInfo").innerHTML="Níveis liberados: <b>"+save.unlocked+"</b> / "+MAX_LEVEL;
}

let L=getLevel(1), keys={}, state="start", score=0, lives=3, hitsOnHeart=0, tick=0, rumble=0, invuln=0;
let spawnTimer=0, timeLeft=0, warnTime=0, toastTime=0;
let doubleTime=0, tripleTime=0, shieldTime=0, shieldHits=0;
let bullets=[], eBullets=[], enemies=[], drops=[], particles=[], flashes=[], allies=[], booms=[], bossFriends=[];
let boss=null;
const player={x:W/2,y:H-120,w:70,h:96,speed:5.6,cd:0};
const stars=Array.from({length:90},()=>({x:Math.random()*W,y:Math.random()*H,s:Math.random()*2+.3,v:Math.random()*1.6+.25}));
const warnEl=document.getElementById("warn"), toastEl=document.getElementById("toast");
const heartsEl=document.getElementById("hearts"), hpEl=document.getElementById("hpEl"), scoreEl=document.getElementById("scoreEl");
const waveEl=document.getElementById("waveEl"), subEl=document.getElementById("subEl");
const tDouble=document.getElementById("tDouble"), tTriple=document.getElementById("tTriple"), tShield=document.getElementById("tShield");

function playing(){ return state==="play"||state==="boss"||state==="warn"; }
function toast(msg,frames){ toastEl.textContent=msg; toastEl.style.display="block"; toastTime=frames||90; }
function clock(frames){ const s=Math.max(0,Math.ceil(frames/60)); return Math.floor(s/60)+":"+String(s%60).padStart(2,"0"); }
function setTimer(el,on,left,max,extra){
  if(!on){ el.classList.remove("on"); return; }
  el.classList.add("on");
  el.querySelector("span").textContent=(extra?extra+" • ":"")+Math.ceil(left/60)+"s";
  el.querySelector("i").style.width=clamp(left/max*100,0,100)+"%";
}
function hud(){
  heartsEl.textContent="❤️".repeat(Math.max(0,lives))+"🖤".repeat(Math.max(0,3-lives));
  hpEl.textContent="TIROS NESTE CORAÇÃO: "+hitsOnHeart+" / 5";
  scoreEl.textContent="PONTOS: "+score;
  waveEl.textContent="NÍVEL "+L.n+" / "+MAX_LEVEL;
  if(state==="boss") subEl.textContent="CHEFÃO: "+L.boss.name;
  else if(state==="warn") subEl.textContent="ALERTA DE CHEFÃO";
  else subEl.textContent = cfg.clock!==false ? ("TEMPO "+clock(timeLeft)+"  •  até o chefão") : "Em batalha";
  setTimer(tDouble, doubleTime>0 && tripleTime<=0, doubleTime, DOUBLE_MAX, "");
  setTimer(tTriple, tripleTime>0, tripleTime, TRIPLE_MAX, "");
  setTimer(tShield, shieldTime>0||shieldHits>0, shieldTime, SHIELD_MAX, shieldHits>0?"x"+shieldHits:"");
}

let actx=null;
function unlockAudio(){ try{ if(!actx) actx=new (window.AudioContext||window.webkitAudioContext)(); if(actx.state==="suspended") actx.resume(); }catch(e){} }
function beep(freq,dur,type,vol,slide){
  if(!cfg.sound||!actx) return;
  const t=actx.currentTime,o=actx.createOscillator(),g=actx.createGain();
  o.type=type||"square"; o.frequency.setValueAtTime(freq,t);
  if(slide) o.frequency.exponentialRampToValueAtTime(Math.max(40,slide),t+dur);
  g.gain.setValueAtTime((vol||.08)*cfg.volume,t); g.gain.exponentialRampToValueAtTime(.001,t+dur);
  o.connect(g); g.connect(actx.destination); o.start(t); o.stop(t+dur);
}
function noise(dur,vol){
  if(!cfg.sound||!actx) return;
  const n=Math.floor(actx.sampleRate*dur),buf=actx.createBuffer(1,n,actx.sampleRate),d=buf.getChannelData(0);
  for(let i=0;i<n;i++) d[i]=(Math.random()*2-1)*(1-i/n);
  const s=actx.createBufferSource(),g=actx.createGain(),f=actx.createBiquadFilter();
  f.type="lowpass"; f.frequency.value=900; s.buffer=buf; s.connect(f); f.connect(g); g.connect(actx.destination);
  g.gain.setValueAtTime((vol||.12)*cfg.volume,actx.currentTime);
  g.gain.exponentialRampToValueAtTime(.001,actx.currentTime+dur); s.start();
}
const PACKS=[
  {name:"Clássico", shoot:[980,"square",.06,380], boom:[180,"sawtooth",.2], power:[520,780], wave:"square"},
  {name:"Laser Neon", shoot:[1240,"sawtooth",.05,500], boom:[140,"sawtooth",.22], power:[660,990], wave:"sawtooth"},
  {name:"Estrela", shoot:[880,"triangle",.07,440], boom:[220,"triangle",.18], power:[700,1050], wave:"triangle"},
  {name:"Robô", shoot:[200,"square",.08,120], boom:[90,"square",.25], power:[180,360], wave:"square"},
  {name:"Cristal", shoot:[1400,"sine",.07,900], boom:[400,"sine",.2], power:[900,1400], wave:"sine"},
  {name:"Trovão", shoot:[300,"sawtooth",.08,80], boom:[70,"sawtooth",.35], power:[200,500], wave:"sawtooth"},
  {name:"8-bits", shoot:[660,"square",.05,330], boom:[110,"square",.16], power:[440,880], wave:"square"},
  {name:"Espacial", shoot:[420,"triangle",.09,180], boom:[60,"triangle",.28], power:[300,600], wave:"triangle"},
  {name:"Doce", shoot:[1100,"sine",.06,700], boom:[500,"sine",.16], power:[800,1200], wave:"sine"},
  {name:"Heroico", shoot:[740,"sawtooth",.07,360], boom:[160,"sawtooth",.24], power:[392,784], wave:"sawtooth"}
];
function pack(){ return PACKS[cfg.pack|0] || PACKS[0]; }
function previewPack(){
  unlockAudio();
  const p=pack();
  beep(p.shoot[0], p.shoot[2], p.shoot[1], .07, p.shoot[3]);
  setTimeout(()=>{ noise(.18,.14); beep(p.boom[0], p.boom[2], p.boom[1], .08, 50); }, 180);
  setTimeout(()=>{ beep(p.power[0],.12,p.wave,.07); setTimeout(()=>beep(p.power[1],.14,p.wave,.07),80); }, 420);
}
const sfx={
  shoot(){ const p=pack(); beep(p.shoot[0], p.shoot[2], p.shoot[1], .045, p.shoot[3]); },
  boom(){ const p=pack(); noise(.22,.16); beep(p.boom[0], p.boom[2], p.boom[1], .06, 50); },
  power(){ const p=pack(); beep(p.power[0],.12,p.wave,.07); setTimeout(()=>beep(p.power[1],.14,p.wave,.07),80); },
  hit(){ const p=pack(); beep(Math.max(80,p.boom[0]-20),.18,p.boom[1],.07,60); },
  life(){ const p=pack(); beep(p.power[0],.1,p.wave,.07); setTimeout(()=>beep(p.power[1],.16,p.wave,.07),90); },
  warn(){ const p=pack(); beep(p.shoot[0]*0.4,.16,p.wave,.06); setTimeout(()=>beep(p.shoot[0]*0.55,.25,p.wave,.07),260); },
  boss(){ const p=pack(); beep(Math.max(60,p.boom[0]*0.6),.5,p.boom[1],.08,50); },
  ally(){ const p=pack(); beep(p.power[0],.1,p.wave,.06); setTimeout(()=>beep(p.power[1],.16,p.wave,.06),90); },
  eShot(){ const p=pack(); beep(Math.max(180,p.shoot[0]*0.55), 0.05, p.wave, 0.035, Math.max(90,p.shoot[3]*0.5)); },
  eliteShot(){ const p=pack(); beep(Math.max(160,p.shoot[0]*0.42), 0.06, p.wave, 0.045, 90); },
  bShot(){ const p=pack(); beep(Math.max(110,p.boom[0]*0.9), 0.08, p.boom[1], 0.07, 70); noise(0.05, 0.06); },
  minionShot(){ const p=pack(); beep(Math.max(200,p.shoot[0]*0.48), 0.055, p.wave, 0.04, 100); },
  win(){ beep(523,.12,"triangle",.07); setTimeout(()=>beep(659,.12,"triangle",.07),120); setTimeout(()=>beep(784,.2,"triangle",.08),240); }
};

function burst(x,y,color,n){
  const extra=cfg.fx==="high"?10: cfg.fx==="low"?-4:0;
  for(let i=0;i<Math.max(3,n+extra);i++){
    const a=Math.random()*Math.PI*2,sp=Math.random()*3.2+.6;
    particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:20+Math.random()*18,color});
  }
}
function explode(x,y,kind){
  const boss=kind==="boss";
  booms.push({x,y,kind: boss?"boss":"ship", life:0, max: boss?34:18, size: boss?170:70});
  burst(x,y, boss?"#ffd070":"#ff9a3a", boss?28:14);
}
function fireBolt(x,y,fromAlly){
  bullets.push({x:x-3,y:y,w:6,h:22,vy:-11,trail:[],dmg:L.playerDmg,ally:!!fromAlly});
  flashes.push({x,y:y+8,life:8});
}
function playerShoot(){
  const y=player.y-player.h/2+6;
  if(tripleTime>0){ fireBolt(player.x-20,y); fireBolt(player.x,y-6); fireBolt(player.x+20,y); player.cd=9; }
  else if(doubleTime>0){ fireBolt(player.x-16,y); fireBolt(player.x+16,y); player.cd=10; }
  else { fireBolt(player.x,y); player.cd=13; }
  sfx.shoot();
}
function spawnEnemy(){
  const elite=Math.random()<L.eliteChance;
  const w=elite?54:42,h=elite?50:46;
  enemies.push({
    x:24+Math.random()*(W-48-w), y:-h-4, w,h,
    vy:(L.enemySpeed*(elite?.85:1)+Math.random()*.35)*enemySpdMul(),
    vx:(Math.random()-.5)*(.55+L.n*0.004),
    kind:elite?"elite":"enemy", hp:elite?L.eliteHp:L.enemyHp,
    img:elite?IMG.elite:IMG.enemy, cd:30+Math.floor(Math.random()*50)
  });
}
function spawnAllies(){
  allies=[];
  if(!cfg.ally || !L.allies) return;
  for(let i=0;i<L.allies;i++) allies.push({x:player.x+(i%2===0?-1:1)*58,y:player.y+18,w:40,h:54,side:(i%2===0?-1:1),cd:20+i*8});
  if(L.allies) { toast(L.allies>1?"DOIS AMIGOS DE SUPORTE!":"AMIGO DE SUPORTE NA ÁREA!",110); sfx.ally(); }
}
function startWarn(){
  if(state!=="play") return;
  state="warn"; warnTime=60*3; bullets=[]; eBullets=[]; enemies=[];
  warnEl.innerHTML="⚠ CHEFÃO CHEGANDO ⚠<br><span style='font-size:14px'>"+L.boss.name+"</span>";
  warnEl.style.display="block"; sfx.warn(); hud();
}
function spawnBoss(){
  state="boss"; enemies=[]; bossFriends=[]; warnTime=0; warnEl.style.display="none"; bullets=[]; eBullets=[];
  const B=L.boss;
  const hp=Math.floor(L.bossHp * diffMul());
  boss={x:W/2-B.w/2,y:36,w:B.w,h:B.h,hp,max:hp,vx:L.bossSpeed*(Math.random()<.5?1:-1),shoot:0,entered:false,dash:0,lock:80};
  rumble=cfg.shake?40:0; sfx.boss(); toast(B.name+" • "+B.moveName+" / "+B.atkName,130); hud();
  bossFriends=[];
  const nF = L.n>=3 ? (L.n>=15?2:1) : 0;
  for(let i=0;i<nF;i++){
    bossFriends.push({x:boss.x+(i?80:-20), y:boss.y+70, w:36, h:40, side:i?1:-1, cd:20+i*15, hp:2+Math.floor(L.n/20)});
  }
  if(nF) toast("O chefão trouxe "+nF+" amigo"+(nF>1?"s":"")+"!", 90);
}
function dropAt(x,y,force){
  if(lives<3 && Math.random() < (force?0.45:0.16)){
    drops.push({x:x-12,y,w:22,h:22,vy:1.5,type:"life"}); return;
  }
  if(!force && Math.random()>L.dropChance) return;
  const r=Math.random();
  drops.push({x:x-12,y,w:24,h:32,vy:1.55,type:r<.36?"double":r<.66?"triple":"shield"});
}
function takeHit(){
  if(invuln>0) return;
  if(shieldHits>0){ shieldHits--; invuln=25; burst(player.x,player.y,"#8ff",16); sfx.hit(); hud(); return; }
  hitsOnHeart++;
  invuln=18;
  burst(player.x,player.y,"#8cf",8);
  sfx.hit();
  if(hitsOnHeart>=5){
    hitsOnHeart=0;
    lives--;
    invuln=70;
    burst(player.x,player.y,"#0ff",22);
    toast("VIDA PERDIDA — pegue um coração ❤️", 90);
    if(lives<=0){ state="gameover"; warnEl.style.display="none"; noise(.4,.18); }
  } else {
    toast("Atingido "+hitsOnHeart+"/5 neste coração", 50);
  }
  hud();
}
function showLevelComplete(){
  state="clear";
  if(L.n>=save.unlocked) save.unlocked=Math.min(MAX_LEVEL, L.n+1);
  save.pick=Math.min(MAX_LEVEL, L.n+1);
  save.score=Math.max(save.score,score); persist();
  document.getElementById("clearLevel").textContent="Nível "+L.n+" de "+MAX_LEVEL;
  document.getElementById("clearBoss").textContent="Você derrotou: "+L.boss.name;
  document.getElementById("clearScore").textContent="Pontos: "+score+(L.n>=MAX_LEVEL?" • 300 NÍVEIS!":"");
  document.getElementById("btnPickAfter").textContent = L.n>=MAX_LEVEL ? "🏆  ESCOLHER NÍVEL" : "▶  ESCOLHER PRÓXIMO NÍVEL";
  showOnly(ovClear); sfx.win();
}
function beginRun(n){
  L=getLevel(n||1); score=0; lives=3; hitsOnHeart=0;
  bullets=[]; eBullets=[]; enemies=[]; drops=[]; particles=[]; flashes=[];
  boss=null; player.x=W/2; player.y=H-120; player.cd=0; player.speed=shipSpeed();
  spawnTimer=0; timeLeft=L.preBoss; warnTime=0;
  invuln=0; doubleTime=0; tripleTime=0; shieldTime=0; shieldHits=0;
  state="play"; spawnAllies(); warnEl.style.display="none"; persist(); hud();
  toast("NÍVEL "+L.n+" • "+L.minutes+" min até o chefão", 120);
}

const padPrev={start:false, a:false, b:false};
function readPad(){
  const out={mx:0,my:0,shoot:false,start:false,a:false,b:false,ok:false,name:""};
  if(cfg.pad===false || !navigator.getGamepads) return out;
  const list=navigator.getGamepads();
  let gp=null;
  for(let i=0;i<list.length;i++) if(list[i] && list[i].connected){ gp=list[i]; break; }
  if(!gp) return out;
  out.ok=true; out.name=gp.id||"controle";
  const ax=gp.axes||[];
  const bt=gp.buttons||[];
  const pressed=i=> !!(bt[i] && (bt[i].pressed || bt[i].value>0.4));
  let mx=0, my=0;
  if(ax[0]<=-0.25) mx+=ax[0]; if(ax[0]>=0.25) mx+=ax[0];
  if(ax[1]<=-0.25) my+=ax[1]; if(ax[1]>=0.25) my+=ax[1];
  if(pressed(14)) mx-=1; if(pressed(15)) mx+=1;
  if(pressed(12)) my-=1; if(pressed(13)) my+=1;
  out.mx=clamp(mx,-1,1); out.my=clamp(my,-1,1);
  out.shoot=pressed(0)||pressed(7)||pressed(5)||pressed(2);
  out.start=pressed(9)||pressed(8);
  out.a=pressed(0); out.b=pressed(1);
  return out;
}
function pollPadMenus(p){
  const startEdge=p.start && !padPrev.start;
  const aEdge=p.a && !padPrev.a;
  padPrev.start=p.start; padPrev.a=p.a; padPrev.b=p.b;
  if(startEdge && playing()){ state="pause"; warnEl.style.display="none"; showOnly(ovPause); return; }
  if(startEdge && state==="pause"){ resumeGame(); return; }
  if((aEdge||startEdge) && state==="start") openLevels();
  if((aEdge||startEdge) && state==="clear") openLevels();
  if((aEdge||startEdge) && state==="gameover") openLevels();
  if(aEdge && state==="pause") resumeGame();
}
function updatePlayer(){
  const pad=readPad();
  pollPadMenus(pad);
  let mx=0,my=0;
  if(keys["arrowleft"]||keys["a"]) mx-=1;
  if(keys["arrowright"]||keys["d"]) mx+=1;
  if(keys["arrowup"]||keys["w"]) my-=1;
  if(keys["arrowdown"]||keys["s"]) my+=1;
  mx+=pad.mx; my+=pad.my;
  mx=clamp(mx,-1,1); my=clamp(my,-1,1);
  if(mx&&my){ mx*=.72; my*=.72; }
  player.x=clamp(player.x+mx*player.speed, player.w/2+4, W-player.w/2-4);
  player.y=clamp(player.y+my*player.speed, 70, H-58);
  if(player.cd>0) player.cd--;
  const wantShot = keys[" "]||keys["space"]||cfg.auto||pad.shoot;
  if(wantShot && player.cd===0 && playing()) playerShoot();
}
function updateAllies(){
  allies.forEach((a,i)=>{
    a.x+=(player.x+a.side*(52+i*8)-a.x)*0.12; a.y+=(player.y+16-a.y)*0.12;
    if(a.cd>0) a.cd--; else { fireBolt(a.x,a.y-a.h/2,true); a.cd=Math.max(14,22-Math.floor(L.n/40)); }
  });
}
function bossShoot(){
  sfx.bShot();
  const cx=boss.x+boss.w/2, cy=boss.y+boss.h-6, spd=(2.6+L.n*0.012)*diffMul(), atk=L.boss.atk;
  const push=(vx,vy)=> eBullets.push({x:cx-4,y:cy,w:8,h:12,vx,vy});
  if(atk===0) push(0,spd);
  else if(atk===1){ for(let i=-2;i<=2;i++) push(i*1.1,spd); }
  else if(atk===2){ const dx=player.x-cx,dy=player.y-cy,l=Math.hypot(dx,dy)||1; push(dx/l*spd*1.2,dy/l*spd*1.2); }
  else if(atk===3){ for(let i=-1;i<=1;i++) push(i*1.4,spd); const dx=player.x-cx,dy=player.y-cy,l=Math.hypot(dx,dy)||1; push(dx/l*spd,dy/l*spd); }
  else if(atk===4){ for(let i=0;i<10;i++){ const a=Math.PI*2*i/10; push(Math.cos(a)*spd, Math.sin(a)*spd+1.2); } }
  else if(atk===5){ push(-2.2,spd); push(2.2,spd); push(0,spd+.6); }
  else if(atk===6){ push(0,spd+1.4); push(-.4,spd+.6); push(.4,spd+.6); }
  else if(atk===7){ push(Math.sin(tick/8)*2.4,spd); push(-Math.sin(tick/8)*2.4,spd); }
  else if(atk===8){ push(0,spd); push(spd,0); push(-spd,0); const dx=player.x-cx,dy=player.y-cy,l=Math.hypot(dx,dy)||1; push(dx/l*spd,dy/l*spd); }
  else { for(let i=0;i<8;i++){ const a=-Math.PI/2+(i-3.5)*0.28; push(Math.cos(a)*spd, Math.sin(a)*spd+2); } }
}
function updateBoss(){
  if(!boss) return;
  if(!boss.entered){ if(boss.lock>0){ boss.lock--; if(boss.lock<=0) boss.entered=true; } return; }
  const m=L.boss.move, ch=L.bossChase*diffMul()*1.55, tx=player.x-boss.w/2;
  const bob=Math.sin(tick*0.08)*1.8;
  if(Math.abs(boss.vx)<1.2) boss.vx = (boss.vx>=0?1:-1)*(L.bossSpeed*1.4);
  if(m===0){ boss.x+=boss.vx*1.6; boss.y=36+Math.sin(tick*0.07)*22; if(boss.x<6||boss.x+boss.w>W-6) boss.vx*=-1; }
  else if(m===1){ boss.x+=Math.sign(tx-boss.x)*ch*1.4; boss.y=32+Math.sin(tick*0.1)*26; }
  else if(m===2){ boss.x+=Math.sign(tx-boss.x)*ch*1.3; boss.y+=ch*0.75+bob; if(boss.y>player.y-80) boss.y=26+Math.sin(tick*0.09)*16; }
  else if(m===3){ const ty=Math.min(player.y-90,240); boss.x+=Math.sign(tx-boss.x)*ch*1.5; boss.y+=Math.sign(ty-boss.y)*ch*0.9; }
  else if(m===4){ boss.x=W/2-boss.w/2+Math.sin(tick*0.055)*160; boss.y=36+Math.cos(tick*0.09)*48; }
  else if(m===5){ boss.x+=boss.vx*1.7; boss.y=30+Math.sin(tick*0.11)*40; if(boss.x<6||boss.x+boss.w>W-6) boss.vx*=-1; }
  else if(m===6){ if(boss.dash<=0){ boss.dash=55; boss.vx=Math.sign(tx-boss.x)*ch*3.2; } boss.dash--; boss.x+=boss.vx; boss.y+= (boss.dash>25?2.2:-1.6); }
  else if(m===7){ boss.x=clamp(boss.x+Math.sign(tx-boss.x)*L.bossSpeed*1.3,8,W-boss.w-8); boss.y=28+Math.sin(tick*0.12)*38; }
  else if(m===8){ const t=tick*0.07; boss.x=W/2-boss.w/2+Math.sin(t)*165; boss.y=40+Math.abs(Math.sin(t*0.7))*110; }
  else if(m===9){ boss.x+=Math.sign(tx-boss.x)*ch*1.7; boss.y+=(Math.min(player.y-80,220)-boss.y)*0.06; }
  else if(m===10){ boss.x=W/2-boss.w/2+Math.sin(tick*0.08)*180; boss.y=34+Math.sin(tick*0.05)*30; }
  else { if(tick%45===0) boss.x=clamp(player.x-boss.w/2+(Math.random()-.5)*70,8,W-boss.w-8); boss.y=28+Math.sin(tick*0.1)*36; }
  if(tick%70===0) boss.vx*=-1;
  boss.x=clamp(boss.x,6,W-boss.w-6); boss.y=clamp(boss.y,20,280);
  boss.shoot++;
  if(boss.shoot>Math.max(9, L.bossFire/diffMul())){ boss.shoot=0; bossShoot(); }
  bossFriends.forEach(f=>{
    const tx2=boss.x+boss.w/2+f.side*70, ty2=boss.y+58+Math.sin(tick*0.12+f.side)*16;
    f.x+=(tx2-f.x)*0.12; f.y+=(ty2-f.y)*0.12;
    if(f.cd>0) f.cd--;
    else {
      f.cd=Math.max(22, 48-L.n*0.08);
      const dx=player.x-f.x, dy=player.y-f.y, len=Math.hypot(dx,dy)||1, spd=2.6*diffMul();
      eBullets.push({x:f.x-3,y:f.y+10,w:6,h:14,vx:dx/len*spd,vy:dy/len*spd,enemyShot:true});
      sfx.minionShot();
    }
  });
}

function update(){
  tick++;
  stars.forEach(s=>{ s.y+=s.v; if(s.y>H){s.y=0;s.x=Math.random()*W;} });
  particles.forEach(p=>{ p.x+=p.vx; p.y+=p.vy; p.life--; });
  particles=particles.filter(p=>p.life>0);
  flashes.forEach(f=>f.life--); flashes=flashes.filter(f=>f.life>0);
  booms.forEach(b=>b.life++);
  booms=booms.filter(b=>b.life<b.max);
  if(rumble>0) rumble--;
  if(toastTime>0){ toastTime--; if(toastTime<=0) toastEl.style.display="none"; }
  if(!playing()) pollPadMenus(readPad());
  if(state==="warn"){ warnTime--; warnEl.style.opacity=(Math.floor(tick/8)%2)?"1":".35"; if(warnTime<=0) spawnBoss(); }
  if(state==="bossboom"){ warnTime--; if(warnTime<=0) showLevelComplete(); }
  if(!playing()) return;

  if(doubleTime>0) doubleTime--;
  if(tripleTime>0) tripleTime--;
  if(shieldTime>0){ shieldTime--; if(shieldTime===0) shieldHits=0; }
  if(invuln>0) invuln--;
  if(tick%20===0) hud();
  updatePlayer(); updateAllies();

  bullets.forEach(b=>{
    b.trail.push({x:b.x+b.w/2,y:b.y+b.h,life:8});
    if(b.trail.length>8) b.trail.shift();
    b.trail.forEach(t=>t.life--); b.trail=b.trail.filter(t=>t.life>0); b.y+=b.vy;
  });
  bullets=bullets.filter(b=>b.y>-30);
  eBullets.forEach(b=>{ b.y+=b.vy; b.x+=b.vx||0; });
  eBullets=eBullets.filter(b=>b.y<H+20&&b.x>-20&&b.x<W+20);

  if(state==="play"){
    if(timeLeft>0) timeLeft--;
    spawnTimer++;
    if(spawnTimer>L.spawnInterval){ spawnEnemy(); spawnTimer=0; }
    if(timeLeft<=0) startWarn();
  }
  enemies.forEach(e=>{
    e.y+=e.vy; e.x+=e.vx||0; if(e.x<8||e.x+e.w>W-8) e.vx*=-1;
    if(state!=="play"||e.y<30||e.y>H-90) return;
    e.cd--;
    if(e.cd<=0){
      e.cd=(e.kind==="elite"?Math.max(28,55-L.n*0.08):Math.max(40,78-L.n*0.1))/diffMul();
      const cx=e.x+e.w/2, cy=e.y+e.h-2, dx=player.x-cx, dy=player.y-cy, len=Math.hypot(dx,dy)||1;
      const spd=(e.kind==="elite"?3.1:2.5)*diffMul();
      eBullets.push({x:cx-3,y:cy,w:6,h:16,vx:dx/len*spd,vy:dy/len*spd,enemyShot:true});
      if(e.kind==="elite") eBullets.push({x:cx-3,y:cy,w:6,h:14,vx:0,vy:spd+.4,enemyShot:true});
      if(e.kind==="elite") sfx.eliteShot(); else sfx.eShot();
    }
  });

  bullets.forEach(b=>{
    enemies.forEach(e=>{
      bossFriends.forEach(f=>{
      if(f.hp>0 && rects(b,{x:f.x-f.w/2,y:f.y-f.h/2,w:f.w,h:f.h})){
        f.hp-=b.dmg; b.y=-999; burst(f.x,f.y,"#f6f",10);
        if(f.hp<=0){ explode(f.x,f.y,"ship"); sfx.boom(); score+=20; }
      }
    });
    if(e.hp>0 && rects(b,e)){
        e.hp-=b.dmg; b.y=-999; burst(e.x+e.w/2,e.y+e.h/2,e.kind==="elite"?"#f6f":"#fa4",8);
        if(e.hp<=0){ score+=e.kind==="elite"?30:10; sfx.boom(); explode(e.x+e.w/2,e.y+e.h/2,"ship"); dropAt(e.x+e.w/2,e.y+e.h/2,e.kind==="elite"); hud(); }
      }
    });
    if(boss && boss.entered && boss.hp>0 && rects(b,boss)){
      boss.hp-=b.dmg; b.y=-999; burst(b.x,b.y,"#8f8",6);
      if(boss.hp<=0){ explode(boss.x+boss.w/2,boss.y+boss.h/2,"boss"); sfx.boom(); score+=120+L.n*10; boss=null; state="bossboom"; warnTime=36; }
    }
  });
  enemies=enemies.filter(e=>e.hp>0 && e.y<H+50);
  bossFriends=bossFriends.filter(f=>f.hp>0);
  updateBoss();
  drops.forEach(d=>d.y+=d.vy); drops=drops.filter(d=>d.y<H+20);
  const pbox={x:player.x-player.w*.32,y:player.y-player.h*.35,w:player.w*.64,h:player.h*.7};
  drops.forEach(d=>{
    if(!rects(d,pbox)) return;
    d.y=H+99;
    if(d.type==="life"){ if(lives<3){ lives++; hitsOnHeart=0; sfx.life(); toast("VIDA RECUPERADA ❤️",80); } else if(hitsOnHeart>0){ hitsOnHeart=0; sfx.life(); toast("CORAÇÃO RESTAURADO",80); } }
    else if(d.type==="triple"){ tripleTime=TRIPLE_MAX; doubleTime=0; sfx.power(); }
    else if(d.type==="double"){ if(tripleTime>0) tripleTime=TRIPLE_MAX; else doubleTime=DOUBLE_MAX; sfx.power(); }
    else { shieldHits=2; shieldTime=SHIELD_MAX; sfx.power(); }
    hud();
  });
  enemies.forEach(e=>{ if(e.hp>0 && rects(e,pbox)){ e.hp=0; takeHit(); } });
  eBullets.forEach(b=>{ if(rects(b,pbox)){ b.y=H+99; takeHit(); } });
  if(boss && boss.entered && rects(boss,pbox)) takeHit();
  bossFriends.forEach(f=>{ if(rects({x:f.x-f.w/2,y:f.y-f.h/2,w:f.w,h:f.h}, pbox)) takeHit(); });
}

function drawImg(img,x,y,w,h){ if(img&&img.complete&&img.naturalWidth) ctx.drawImage(img,x,y,w,h); else { ctx.fillStyle="#0af"; ctx.fillRect(x,y,w,h); } }
function drawLaser(b){
  const cx=b.x+b.w/2;
  b.trail.forEach(t=>{ ctx.globalAlpha=t.life/14; ctx.fillStyle=b.ally?"#c8f":"#7cf4ff"; ctx.beginPath(); ctx.arc(t.x,t.y,2.2,0,Math.PI*2); ctx.fill(); });
  ctx.globalAlpha=1; ctx.save(); ctx.shadowColor=b.ally?"#d6f":"#5df"; ctx.shadowBlur=16;
  ctx.fillStyle=b.ally?"#f8c":"#baf8ff"; ctx.fillRect(cx-2.2,b.y,4.4,b.h); ctx.fillStyle="#fff"; ctx.fillRect(cx-1.1,b.y-2,2.2,b.h+2); ctx.restore();
}
function drawEBolt(b){
  const cx=b.x+b.w/2,cy=b.y+b.h/2; ctx.save();
  if(b.enemyShot){
    ctx.shadowColor="#f84"; ctx.shadowBlur=14; ctx.fillStyle="#ffb080";
    ctx.beginPath(); ctx.moveTo(cx,cy+10); ctx.lineTo(cx-2.4,cy-8); ctx.lineTo(cx+2.4,cy-8); ctx.closePath(); ctx.fill();
    ctx.fillStyle="#fff"; ctx.fillRect(cx-1,cy-8,2,14);
  } else {
    ctx.shadowColor="#7f6"; ctx.shadowBlur=12; ctx.fillStyle="#cfff9a";
    ctx.beginPath(); ctx.ellipse(cx,cy,4,8,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle="#fff"; ctx.beginPath(); ctx.ellipse(cx,cy,1.6,4,0,0,Math.PI*2); ctx.fill();
  }
  ctx.restore();
}
function drawEngine(px,py){
  const flame=16*(.7+Math.sin(tick*.45)*.3)+6;
  const gx=ctx.createLinearGradient(px,py,px,py+flame);
  gx.addColorStop(0,"rgba(255,255,255,.95)"); gx.addColorStop(.25,"rgba(120,220,255,.9)"); gx.addColorStop(1,"rgba(0,80,255,0)");
  ctx.fillStyle=gx; ctx.beginPath(); ctx.moveTo(px-6,py); ctx.lineTo(px,py+flame); ctx.lineTo(px+6,py); ctx.closePath(); ctx.fill();
}
function drawUniqueBoss(){
  const B=L.boss, x=boss.x, y=boss.y, w=boss.w, h=boss.h, cx=x+w/2, cy=y+h/2;
  const hue=B.hue, body=B.body, pulse=0.7+Math.sin(tick/7)*0.3;
  const cHull=`hsl(${hue},80%,52%)`, cDark=`hsl(${hue},75%,28%)`, cWing=`hsl(${(hue+25)%360},70%,40%)`;
  const cLite=`hsl(${hue},90%,72%)`, cGlow=`hsl(${(hue+180)%360},90%,60%)`, cNose=`hsl(${hue},40%,85%)`;
  ctx.save();
  ctx.shadowColor=cLite; ctx.shadowBlur=16;
  ctx.translate(cx, cy);
  const bw=w, bh=h;

  function hullTri(){
    ctx.fillStyle=cHull;
    ctx.beginPath(); ctx.moveTo(0,-bh*0.48); ctx.lineTo(bw*0.22,bh*0.42); ctx.lineTo(-bw*0.22,bh*0.42); ctx.closePath(); ctx.fill();
    ctx.fillStyle=cDark; ctx.beginPath(); ctx.moveTo(0,-bh*0.48); ctx.lineTo(bw*0.08,bh*0.42); ctx.lineTo(-bw*0.08,bh*0.42); ctx.closePath(); ctx.fill();
  }
  function wingsWide(spread, drop){
    ctx.fillStyle=cWing;
    ctx.beginPath(); ctx.moveTo(-bw*0.08, -bh*0.05); ctx.lineTo(-spread, drop); ctx.lineTo(-bw*0.06, bh*0.22); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(bw*0.08, -bh*0.05); ctx.lineTo(spread, drop); ctx.lineTo(bw*0.06, bh*0.22); ctx.closePath(); ctx.fill();
  }
  function engines(n){
    ctx.fillStyle=cGlow;
    for(let i=0;i<n;i++){
      const px=(i-(n-1)/2)*16;
      ctx.beginPath(); ctx.moveTo(px-5,bh*0.38); ctx.lineTo(px,bh*0.38+10+pulse*8); ctx.lineTo(px+5,bh*0.38); ctx.closePath(); ctx.fill();
    }
  }
  function cockpit(){
    ctx.fillStyle=cNose;
    ctx.beginPath(); ctx.ellipse(0,-bh*0.18,9,12,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle="#8df"; ctx.beginPath(); ctx.ellipse(0,-bh*0.20,5,7,0,0,Math.PI*2); ctx.fill();
  }
  function cannons(n){
    ctx.fillStyle="#ccc";
    for(let i=0;i<n;i++){
      const px=(i-(n-1)/2)*18;
      ctx.fillRect(px-2, bh*0.2, 4, 16);
    }
  }

  if(body===0){ // caca interceptor
    hullTri(); wingsWide(bw*0.48, bh*0.12); engines(2); cockpit(); cannons(2);
  } else if(body===1){ // bomber largo
    ctx.fillStyle=cHull; ctx.beginPath(); ctx.ellipse(0,0,bw*0.28,bh*0.42,0,0,Math.PI*2); ctx.fill();
    wingsWide(bw*0.52, bh*0.18); engines(3); cockpit(); cannons(3);
  } else if(body===2){ // asa-delta
    ctx.fillStyle=cHull;
    ctx.beginPath(); ctx.moveTo(0,-bh*0.5); ctx.lineTo(bw*0.5,bh*0.4); ctx.lineTo(0,bh*0.18); ctx.lineTo(-bw*0.5,bh*0.4); ctx.closePath(); ctx.fill();
    engines(2); cockpit(); cannons(1);
  } else if(body===3){ // nave-mae larga
    ctx.fillStyle=cHull; ctx.beginPath(); ctx.roundRect?ctx.roundRect(-bw*0.42,-bh*0.22,bw*0.84,bh*0.5,12):(ctx.fillRect(-bw*0.42,-bh*0.22,bw*0.84,bh*0.5)); ctx.fill();
    ctx.fillStyle=cWing;
    ctx.fillRect(-bw*0.5,-bh*0.06,bw,16);
    engines(4); cockpit(); cannons(4);
  } else if(body===4){ // twin hull
    ctx.fillStyle=cHull;
    ctx.beginPath(); ctx.ellipse(-bw*0.2,0,bw*0.16,bh*0.38,0,0,Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.ellipse(bw*0.2,0,bw*0.16,bh*0.38,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=cWing; ctx.fillRect(-bw*0.22,-bh*0.06,bw*0.44,14);
    engines(2); cockpit(); cannons(2);
  } else if(body===5){ // cruzador com asas altas
    hullTri();
    ctx.fillStyle=cWing;
    ctx.fillRect(-bw*0.46,-bh*0.22,bw*0.92,10);
    ctx.fillRect(-bw*0.46,-bh*0.22,12,bh*0.4);
    ctx.fillRect(bw*0.34,-bh*0.22,12,bh*0.4);
    engines(2); cockpit(); cannons(3);
  } else if(body===6){ // disco com nariz
    ctx.fillStyle=cHull; ctx.beginPath(); ctx.ellipse(0,bh*0.06,bw*0.46,bh*0.2,0,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=cDark; ctx.beginPath(); ctx.moveTo(0,-bh*0.46); ctx.lineTo(bw*0.12,0); ctx.lineTo(-bw*0.12,0); ctx.closePath(); ctx.fill();
    engines(3); cockpit(); cannons(2);
  } else if(body===7){ // aviao de combate clássico
    ctx.fillStyle=cHull; ctx.fillRect(-10,-bh*0.42,20,bh*0.8);
    wingsWide(bw*0.5, bh*0.02);
    ctx.fillStyle=cWing; ctx.beginPath(); ctx.moveTo(-8,bh*0.22); ctx.lineTo(-22,bh*0.42); ctx.lineTo(0,bh*0.32); ctx.lineTo(22,bh*0.42); ctx.lineTo(8,bh*0.22); ctx.fill();
    engines(1); cockpit(); cannons(2);
  } else if(body===8){ // heavy gunship
    ctx.fillStyle=cHull; ctx.beginPath(); ctx.moveTo(-bw*0.16,-bh*0.4); ctx.lineTo(bw*0.16,-bh*0.4); ctx.lineTo(bw*0.28,bh*0.38); ctx.lineTo(-bw*0.28,bh*0.38); ctx.closePath(); ctx.fill();
    ctx.fillStyle=cWing;
    ctx.beginPath(); ctx.moveTo(-bw*0.14,0); ctx.lineTo(-bw*0.5,bh*0.28); ctx.lineTo(-bw*0.12,bh*0.2); ctx.fill();
    ctx.beginPath(); ctx.moveTo(bw*0.14,0); ctx.lineTo(bw*0.5,bh*0.28); ctx.lineTo(bw*0.12,bh*0.2); ctx.fill();
    engines(4); cockpit(); cannons(4);
  } else if(body===9){ // interceptor fino
    ctx.fillStyle=cHull;
    ctx.beginPath(); ctx.moveTo(0,-bh*0.5); ctx.lineTo(bw*0.12,bh*0.45); ctx.lineTo(-bw*0.12,bh*0.45); ctx.closePath(); ctx.fill();
    ctx.fillStyle=cWing;
    ctx.beginPath(); ctx.moveTo(-6,-bh*0.05); ctx.lineTo(-bw*0.46,bh*0.3); ctx.lineTo(-4,bh*0.16); ctx.fill();
    ctx.beginPath(); ctx.moveTo(6,-bh*0.05); ctx.lineTo(bw*0.46,bh*0.3); ctx.lineTo(4,bh*0.16); ctx.fill();
    engines(2); cockpit(); cannons(1);
  } else if(body===10){ // nave com anel/asa circular
    ctx.strokeStyle=cWing; ctx.lineWidth=10; ctx.beginPath(); ctx.ellipse(0,8,bw*0.42,bh*0.18,0,0,Math.PI*2); ctx.stroke();
    ctx.fillStyle=cHull; ctx.beginPath(); ctx.moveTo(0,-bh*0.42); ctx.lineTo(bw*0.16,bh*0.32); ctx.lineTo(-bw*0.16,bh*0.32); ctx.closePath(); ctx.fill();
    engines(2); cockpit(); cannons(2);
  } else { // cargueiro / transport
    ctx.fillStyle=cHull; ctx.fillRect(-bw*0.22,-bh*0.28,bw*0.44,bh*0.62);
    ctx.fillStyle=cDark; ctx.beginPath(); ctx.moveTo(0,-bh*0.48); ctx.lineTo(bw*0.18,-bh*0.2); ctx.lineTo(-bw*0.18,-bh*0.2); ctx.closePath(); ctx.fill();
    wingsWide(bw*0.48, bh*0.08); engines(3); cockpit(); cannons(2);
  }

  ctx.restore();
}
function drawBackdrop(){
  const id=cfg.bg||"atual";
  const oy=(tick*0.12)%H;
  if(id==="atual" && IMG.bg && IMG.bg.complete && IMG.bg.naturalWidth){
    ctx.globalAlpha=0.92;
    ctx.drawImage(IMG.bg,0,-oy,W,H);
    ctx.drawImage(IMG.bg,0,H-oy,W,H);
    ctx.globalAlpha=1;
    return;
  }
  const themes={
    noite:["#02010a","#070616","#000"],
    azul:["#03101c","#0a2238","#061018"],
    roxo:["#100818","#1a0a2a","#080410"],
    verde:["#03140c","#0a2418","#02100a"],
    ouro:["#120e06","#1c160a","#0a0804"],
    estrelas:["#010105","#020208","#000"],
    aurora:["#041016","#06281c","#081022"],
    vermelho:["#140808","#220c0c","#0a0404"],
    oceano:["#020b16","#062030","#041018"],
    cinza:["#0a0a10","#12121a","#07070c"]
  };
  const c=themes[id]||themes.noite;
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,c[0]); g.addColorStop(0.55,c[1]); g.addColorStop(1,c[2]);
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  if(id==="aurora"){
    ctx.globalAlpha=0.18;
    ctx.fillStyle="#40ffaa"; ctx.beginPath(); ctx.ellipse(W*0.3,80,180,40,0.2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle="#40a0ff"; ctx.beginPath(); ctx.ellipse(W*0.7,120,160,36,-0.2,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
  }
}
function draw(){
  const sh=cfg.shake!==false;
  const sx=(sh&&rumble)?(Math.random()-.5)*4:0, sy=(sh&&rumble)?(Math.random()-.5)*3:0;
  ctx.setTransform(1,0,0,1,sx,sy);
  drawBackdrop();
  stars.forEach(s=>{ ctx.fillStyle=`rgba(255,245,200,${.45+s.s/3})`; ctx.fillRect(s.x,s.y,s.s+0.4,s.s+0.4); });
  bullets.forEach(drawLaser); eBullets.forEach(drawEBolt);
  flashes.forEach(f=>{ const a=f.life/8; ctx.save(); ctx.globalAlpha=a; ctx.fillStyle="#fff6b0"; ctx.beginPath(); ctx.arc(f.x,f.y,7*a+3,0,Math.PI*2); ctx.fill(); ctx.restore(); });
  enemies.forEach(e=>drawImg(e.img,e.x,e.y,e.w,e.h));
  bossFriends.forEach(f=>{
    drawImg(IMG.elite, f.x-f.w/2, f.y-f.h/2, f.w, f.h);
  });
  booms.forEach(b=>{
    const t=b.life/b.max, sc=0.45+t*1.15, img=b.kind==="boss"?IMG.boomBoss:IMG.boom;
    const w=b.size*sc, h=b.size*sc;
    ctx.save(); ctx.globalAlpha=1-t*0.85;
    if(img&&img.complete&&img.naturalWidth) ctx.drawImage(img, b.x-w/2, b.y-h/2, w, h);
    else { ctx.fillStyle="rgba(255,200,80,.8)"; ctx.beginPath(); ctx.arc(b.x,b.y,w/2,0,Math.PI*2); ctx.fill(); }
    ctx.restore();
  });
  if(boss){
    drawUniqueBoss();
    const bw=240,bh=8,bx=W/2-120,by=8;
    ctx.fillStyle="#200"; ctx.fillRect(bx-1,by-1,bw+2,bh+2);
    ctx.fillStyle="#3a0"; ctx.fillRect(bx,by,bw*Math.max(0,boss.hp/boss.max),bh);
    ctx.strokeStyle="#8f8"; ctx.strokeRect(bx-1,by-1,bw+2,bh+2);
    ctx.fillStyle="#cfc"; ctx.font="11px Segoe UI"; ctx.textAlign="center"; ctx.fillText(L.boss.name,W/2,by+20);
  }
  drops.forEach(d=>{
    if(d.type==="life"){ ctx.font="20px serif"; ctx.textAlign="center"; ctx.fillText("❤️", d.x+11, d.y+18); }
    else if(d.type==="shield") drawImg(IMG.pwr_shield,d.x,d.y,d.w,d.h);
    else { drawImg(IMG.pwr_double,d.x,d.y,d.w,d.h); ctx.fillStyle=d.type==="triple"?"#ffd24a":"#fff"; ctx.font="bold 10px Segoe UI"; ctx.textAlign="center"; ctx.fillText(d.type==="triple"?"x3":"x2", d.x+d.w/2, d.y+d.h+11); }
  });
  particles.forEach(p=>{ ctx.globalAlpha=Math.max(0,p.life/36); ctx.fillStyle=p.color; ctx.fillRect(p.x,p.y,3,3); ctx.globalAlpha=1; });
  allies.forEach(a=>{ drawEngine(a.x-8,a.y+a.h/2-4); drawEngine(a.x+8,a.y+a.h/2-4); ctx.save(); ctx.globalAlpha=.92; ctx.shadowColor="#d6f"; ctx.shadowBlur=16; drawImg(IMG.player,a.x-a.w/2,a.y-a.h/2,a.w,a.h); ctx.restore(); });
  if(state!=="start"){
    const blink=invuln>0 && Math.floor(invuln/3)%2===0;
    if(!blink || state==="gameover"){
      const px=player.x-player.w/2, py=player.y-player.h/2;
      drawEngine(player.x-12,py+player.h-10); drawEngine(player.x+12,py+player.h-10);
      ctx.save(); ctx.shadowColor="#4df"; ctx.shadowBlur=22; drawImg(IMG.player,px,py,player.w,player.h); ctx.restore();
      if(shieldHits>0){ ctx.strokeStyle=`rgba(80,230,255,${.55+.35*Math.sin(tick/6)})`; ctx.lineWidth=3; ctx.beginPath(); ctx.ellipse(player.x,player.y+6,player.w*.58,player.h*.5,0,0,Math.PI*2); ctx.stroke(); }
    }
  }
  ctx.setTransform(1,0,0,1,0,0);
  if(state==="gameover"){
    ctx.fillStyle="rgba(0,0,10,.72)"; ctx.fillRect(0,0,W,H);
    ctx.textAlign="center"; ctx.fillStyle="#0ff"; ctx.font="bold 34px Segoe UI"; ctx.fillText("FIM DE JOGO",W/2,H/2-16);
    ctx.fillStyle="#fff"; ctx.font="18px Segoe UI"; ctx.fillText("Pontos: "+score+"   Nível: "+L.n,W/2,H/2+20);
    ctx.fillStyle="#8cf"; ctx.font="15px Segoe UI"; ctx.fillText("Aperte R ou escolha outro nível",W/2,H/2+50);
  }
}
function loop(){ update(); draw(); requestAnimationFrame(loop); }

function startFrom(n){ unlockAudio(); beginRun(n); showOnly(null); }
function resumeGame(){ showOnly(null); state=boss?"boss":(warnTime>0?"warn":"play"); }
function goStart(){ state="start"; refreshSaveInfo(); showOnly(ovStart); }
function syncCfg(){
  document.getElementById("optSound").value=cfg.sound?"on":"off";
  document.getElementById("optVol").value=Math.round((cfg.volume||0.7)*100);
  document.getElementById("optPack").value=String(cfg.pack|0);
  document.getElementById("optScreen").value=cfg.screen||"normal";
  document.getElementById("optDiff").value=cfg.diff||"normal";
  document.getElementById("optESpd").value=cfg.eSpd||"slow";
  document.getElementById("optBg").value=cfg.bg||"atual";
  document.getElementById("optSpeed").value=cfg.speed||"normal";
  document.getElementById("optPad").value=cfg.pad!==false?"on":"off";
  document.getElementById("optAuto").value=cfg.auto?"on":"off";
  document.getElementById("optAlly").value=cfg.ally!==false?"on":"off";
  document.getElementById("optFx").value=cfg.fx||"normal";
  document.getElementById("optShake").value=cfg.shake!==false?"on":"off";
  document.getElementById("optClock").value=cfg.clock!==false?"on":"off";
}

document.addEventListener("keydown", e=>{
  const k=e.key.toLowerCase(); keys[k]=true;
  if(e.code==="Space") e.preventDefault();
  if(state==="start" && (e.code==="Space"||k==="enter")) openLevels();
  if(state==="clear" && (e.code==="Space"||k==="enter")) openLevels();
  if(state==="gameover" && k==="r") openLevels();
  if(playing() && (k==="escape"||k==="p")) { state="pause"; warnEl.style.display="none"; showOnly(ovPause); }
  else if(state==="pause" && (k==="escape"||k==="p")) resumeGame();
});
document.addEventListener("keyup", e=> keys[e.key.toLowerCase()]=false);
window.addEventListener("gamepadconnected", e=>{
  toast("Controle conectado: "+((e.gamepad&&e.gamepad.id)||"manette"), 140);
});
window.addEventListener("gamepaddisconnected", ()=> toast("Controle desconectado", 90));

document.getElementById("btnLevels").onclick=openLevels;
document.getElementById("btnPlayPick").onclick=()=> startFrom(pickLevel);
document.getElementById("btnLvBack").onclick=goStart;
document.getElementById("btnPickAfter").onclick=openLevels;
document.getElementById("btnResume").onclick=resumeGame;
document.getElementById("btnMenu").onclick=goStart;
document.getElementById("btnClearMenu").onclick=goStart;
document.getElementById("btnCfgStart").onclick=()=>{ cfg.from="start"; syncCfg(); showOnly(ovCfg); };
document.getElementById("btnCfgPause").onclick=()=>{ cfg.from="pause"; syncCfg(); showOnly(ovCfg); };
document.getElementById("btnCfgBack").onclick=()=>{
  if(cfg.from==="pause"){ state="pause"; showOnly(ovPause); } else { state="start"; showOnly(ovStart); }
};
function bindSel(id, fn){ document.getElementById(id).onchange=e=>{ fn(e.target.value); persist(); applyScreen(); player.speed=shipSpeed(); }; }
bindSel("optSound", v=> cfg.sound=v==="on");
bindSel("optPack", v=> cfg.pack=Number(v));
document.getElementById("btnPreview").onclick=()=>{ unlockAudio(); previewPack(); };
document.getElementById("optVol").oninput=e=>{ cfg.volume=Number(e.target.value)/100; persist(); };
bindSel("optScreen", v=> cfg.screen=v);
bindSel("optDiff", v=> cfg.diff=v);
bindSel("optESpd", v=> cfg.eSpd=v);
bindSel("optBg", v=> cfg.bg=v);
bindSel("optSpeed", v=> cfg.speed=v);
bindSel("optPad", v=> cfg.pad=v==="on");
bindSel("optAuto", v=> cfg.auto=v==="on");
bindSel("optAlly", v=> cfg.ally=v==="on");
bindSel("optFx", v=> cfg.fx=v);
bindSel("optShake", v=> cfg.shake=v==="on");
bindSel("optClock", v=> cfg.clock=v==="on");

Object.keys(SRC).forEach(k=>{ const im=new Image(); im.src=SRC[k]; IMG[k]=im; });
function boot(){ syncCfg(); try{ applyScreen(); }catch(e){} refreshSaveInfo(); hud(); showOnly(ovStart); loop(); }
boot();
</script>
